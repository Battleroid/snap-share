{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this pull request tags the release, publishes it with these notes and pushes the image to ghcr.io.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Docs" },
    { "type": "refactor", "section": "Internal", "hidden": true },
    { "type": "test", "section": "Internal", "hidden": true },
    { "type": "build", "section": "Internal", "hidden": true },
    { "type": "ci", "section": "Internal", "hidden": true },
    { "type": "chore", "section": "Internal", "hidden": true }
  ],
  "packages": {
    ".": { "package-name": "snap", "changelog-path": "CHANGELOG.md" }
  }
}
