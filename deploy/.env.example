# Settings for deploy/compose.yml: copy to .env (chmod 600) and edit.
# compose.yml uses SNAP_IMAGE, SNAP_DOMAIN, SNAP_RAW_DOMAIN, CADDY_TLS,
# CADDY_MAX_BODY and the *_PATH lines; every line is also passed to snap (docs/configuration.md).
# Lines marked SECRET hold credentials.

# Image: a release from the registry, or one built here (make image IMAGE=snap:local).
SNAP_IMAGE=ghcr.io/battleroid/snap-share:v0.1.0

# Host name of the app. DNS must point here before the first start.
SNAP_DOMAIN=share.example.com
# Optional raw content origin, ideally on a separate registrable domain
# (e.g. example-content.net). Empty: content is served from SNAP_DOMAIN.
SNAP_RAW_DOMAIN=
# Certificates from Caddy's own CA instead of Let's Encrypt (LAN-only hosts).
#CADDY_TLS=tls internal
# Caddy's request body limit. Keep it above uploads.max_bytes (Admin › Settings),
# e.g. 4GiB for a 4 GB file limit.
#CADDY_MAX_BODY=1GiB

# Host directories, owned by uid 10001. Defaults: ./data, ./files, ./secrets.
# Put SECRETS_PATH on storage without snapshots or backups.
#DATA_PATH=./data
#FILES_PATH=./files
#SECRETS_PATH=./secrets

# SECRET. Signs cookies and URLs. Generate with: openssl rand -base64 48
SNAP_SECRET_KEY=
# SECRET. The old key while rotating; remove it after a day.
#SNAP_SECRET_KEY_PREVIOUS=

# The subnet of the compose network (compose.yml). Caddy's X-Forwarded-For is trusted from it.
SNAP_TRUSTED_PROXIES=172.31.250.0/24
# Addresses exempt from per-address rate limits, e.g. your LAN as seen through the router.
#SNAP_RATELIMIT_EXEMPT=192.168.1.1
# Only these client addresses may use /admin and the admin API.
#SNAP_ADMIN_CIDRS=192.168.1.0/24

#SNAP_LOG_LEVEL=info

# Mail: invites, verification, password resets. Off while SNAP_SMTP_HOST is unset.
#SNAP_SMTP_HOST=smtp.fastmail.com
#SNAP_SMTP_PORT=465
#SNAP_SMTP_TLS=implicit
#SNAP_SMTP_USER=you@fastmail.com
# SECRET. An app password for snap alone.
#SNAP_SMTP_PASSWORD=
#SNAP_SMTP_FROM=snap <snap@example.com>

# Single sign-on (docs/gitea-sso.md). Off while SNAP_OIDC_ISSUER is unset.
#SNAP_OIDC_ISSUER=https://git.example.com
#SNAP_OIDC_CLIENT_ID=
# SECRET.
#SNAP_OIDC_CLIENT_SECRET=
#SNAP_OIDC_NAME=Gitea
#SNAP_OIDC_AUTO_PROVISION=true
#SNAP_OIDC_ALLOWED_GROUPS=
#SNAP_OIDC_ADMIN_GROUPS=
#SNAP_OIDC_ADMIN_SUBS=
#SNAP_OIDC_LINK_BY_EMAIL=false
